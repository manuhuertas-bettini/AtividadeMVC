@model IEnumerable<AtividadeMVC.Models.Evento>

@{
    ViewData["Title"] = "Eventos Cadastrados";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Eventos Cadastrados</h2>
    <div>
        <a asp-action="Buscar" class="btn btn-outline-secondary me-2">Buscar Eventos</a>
        <a asp-action="Criar" class="btn btn-primary">Novo Evento</a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Nenhum evento cadastrado no momento.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(m => m.Nome)</th>
                <th>@Html.DisplayNameFor(m => m.Local)</th>
                <th>@Html.DisplayNameFor(m => m.DataEvento)</th>
                <th>@Html.DisplayNameFor(m => m.QuantidadeVagas)</th>
                <th>@Html.DisplayNameFor(m => m.ValorIngresso)</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Nome</td>
                    <td>@item.Local</td>
                    <td>@item.DataEvento.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@item.QuantidadeVagas</td>
                    <td>@item.ValorIngresso.ToString("C")</td>
                    <td>
                        <a asp-action="Detalhes" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Detalhes</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}